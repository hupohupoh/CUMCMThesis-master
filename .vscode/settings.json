{
  // 直接用 Windows 侧 TeX Live 编译（WSL 里未安装 TeX，无法构建）。
  // 若以后改用了别的 TeX 发行版，需同步调整下面工具的 command 路径。
  "latex-workshop.latex.recipes": [
    {
      "name": "Windows-latexmk",
      "tools": ["win-latexmk"]
    }
  ],
  "latex-workshop.latex.recipe.default": "Windows-latexmk",
  "latex-workshop.latex.build.enableMagicComments": false,
  "latex-workshop.latex.tools": [
    {
      "name": "win-latexmk",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "main.tex"
      ]
    }
  ]
}
